#!/bin/sh

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
status=0

if [ "$1" = "--hacker-news" ]; then
    "$script_dir/hn-elfeed.py" update &
    hacker_news_pid=$!

    mbsync --all &
    mbsync_pid=$!

    wait "$hacker_news_pid" || status=1
    wait "$mbsync_pid" || status=1
else
    mbsync --all || status=1
fi

exit "$status"
